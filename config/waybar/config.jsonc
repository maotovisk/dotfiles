{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "fixed-center": true,
  "gtk-layer-shell": true,
  "output": ["DP-2"],
  "mode": "dock",
  "exclusive": false,

  // Module layout - optimized for readability
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock", "clock#date", "mpris", "custom/weather"],
  "modules-right": [
    "custom/notifications",
    "tray",
    "cpu",
    "memory",
    "disk",
    "pulseaudio",
    "pulseaudio#microphone",
    "network",
  ],

  // Workspaces - compact numbered dots with a capsule for the focused workspace
  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": true,
    "active-only": false,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
    "sort-by": "number",
  },

  // Window title - elegant and informative
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": false,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹 $1",
      "(.*) - Visual Studio Code": "󰨞 $1",
      "(.*) - vim": " $1",
      "(.*) - zsh": " [$1]",
    },
    "icon": false,
    "icon-size": 14,
  },

  // System monitoring - modern and informative
  "cpu": {
    "interval": 1,
    "format": "󰍛 {usage}%",
    "format-alt": "󰍛 {avg_frequency}GHz",
    "tooltip-format": "Usage: {usage}%\nFrequency: {avg_frequency}GHz\nCores: {load}",
    "on-click": "kitty --class=monitor btop",
    "on-click-right": "kitty --class=monitor htop",
    "states": {
      "warning": 70,
      "critical": 90,
    },
  },
  "memory": {
    "interval": 1,
    "format": "󰾆 {percentage}%",
    "format-alt": "󰾆 {used:0.1f}G",
    "tooltip-format": "Used: {used:0.1f}GB / {total:0.1f}GB\nAvailable: {avail:0.1f}GB\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB",
    "on-click": "kitty --class=monitor btop",
    "states": {
      "warning": 80,
      "critical": 95,
    },
  },
  "disk": {
    "interval": 30,
    "format": "󰋊 {percentage_used}%",
    "format-alt": "󰋊 {free}",
    "path": "/",
    "tooltip-format": "Used: {used} / {total}\nFree: {free} ({percentage_free}%)\nPath: {path}",
    "on-click": "kitty --class=fileman ranger",
    "states": {
      "warning": 80,
      "critical": 95,
    },
  },

  // Audio controls - comprehensive and modern
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂯 {volume}%",
    "format-bluetooth-muted": "󰂲 Muted",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰦧",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "scroll-step": 2,
    "reverse-scrolling": 1,
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol",
    "on-click-middle": "pamixer --set-volume 50",
    "tooltip-format": "Volume: {volume}%\nDevice: {desc}",
    "max-volume": 150,
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭 Muted",
    "on-click": "pamixer --default-source -t",
    "on-click-right": "pavucontrol -t 4",
    "scroll-step": 5,
    "tooltip-format": "Microphone: {volume}%",
  },

  // Network - comprehensive status
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-linked": "󰈁 {ifname} (No IP)",
    "format-disconnected": "󰤭 Disconnected",
    "format-alt": "󰤨 {signalStrength}% {frequency}MHz",
    "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}\nNetmask: {netmask}\nCIDR: {cidr}",
    "tooltip-format-wifi": "SSID: {essid}\nInterface: {ifname}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFrequency: {frequency}MHz",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}\nSpeed: {bandwidthDownBits}/s down, {bandwidthUpBits}/s up",
    "tooltip-format-disconnected": "Network disconnected",
    "on-click": "nm-connection-editor",
    "on-click-right": "kitty --class=netmon nmtui",
    "interval": 2,
    "max-length": 25,
  },

  // Notifications - swaync status
  "custom/notifications": {
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "swaync-client -C -sw",
    "format": "\uf0f3 {}",
    "tooltip": true
  },

  // Clock - elegant time display
  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%a, %d %b %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click-right": "gnome-calendar",
    "on-click": "mode",
  },

  "clock#date": {
    "interval": 60,
    "format": "{:%a %d %b}",
    "format-alt": "{:%d/%m/%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#e0be73'><b>{}</b></span>",
        "days": "<span color='#d7d2c8'><b>{}</b></span>",
        "weeks": "<span color='#b9b5ad'><b>W{}</b></span>",
        "weekdays": "<span color='#aabda9'><b>{}</b></span>",
        "today": "<span color='#f1d69a'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true,
    "reverse-direction": true,
  },
  // Weather - elegant display
  "custom/weather": {
    "exec": "~/.config/waybar/weather.py",
    "return-type": "json",
    "interval": 1800,
    "format": "{}",
    "tooltip": true,
    "on-click": "xdg-open 'https://weather.com'",
  },

  // Media player - comprehensive display
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-len": 35,
    "dynamic-order": ["title", "artist"],
    "player-icons": {
      "default": "󰐊",
      "spotify": "󰓇",
      "firefox": "󰈹",
      "chrome": "󰊯",
      "vlc": "󰕼",
      "mpv": "󰐹",
    },
    "status-icons": {
      "paused": "󰏤",
      "playing": "󰐊",
      "stopped": "󰓛",
    },
    "ignored-players": ["firefox"],
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl volume 0.1+",
    "on-scroll-down": "playerctl volume 0.1-",
    "smooth-scrolling-threshold": 1,
    "tooltip-format": "{player}: {title} - {artist}\nAlbum: {album}",
  },

  // Battery (if laptop)
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery: {capacity}%\nTime: {time}\nPower: {power}W",
  },
}
